# Copy to .env (never commit .env). All values optional.
PORT=3000
HOST=127.0.0.1
# Path to the SQLite database file
EOD_DB_PATH=./data/eod.db
# Set to "false" to skip loading synthetic demo cases/evidence on boot
EOD_AUTO_SEED=true
# Background feed polling (USGS, NASA EONET, CISA, RSS). Interval in ms.
EOD_DISABLE_POLLING=false
EOD_FEED_POLL_MS=600000

# Optional keys / identity for extra public-source lookups
EOD_CONTACT_EMAIL=
COMPANIES_HOUSE_API_KEY=
OPENSANCTIONS_API_KEY=
